# THUNNAL E-COMMERCE - Headless Integration Env Variables
# Duplicate this file to .env.local and populate the values

# Public Shopify Store Domain (e.g. your-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Public Shopify Storefront Access Token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
